APP_HOST=127.0.0.1
APP_PORT=8888
LOG_LEVEL=info
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
# ComfyUI 的 input 目录: 兼容层参考图落盘、image 参数上传后的临时清理使用。
# 查看方式: ComfyUI 启动命令的 --input-directory 参数, 或任务管理器看进程命令行。
# 注意 image 类型参数默认走 ComfyUI /upload/image 接口, 不依赖此配置;
# 该目录留空时兼容层带参考图请求会返回 501, 上传图片的定时清理也会跳过。
COMFYUI_INPUT_DIR=
# LoRA 模型根目录(分号分隔), LoRA 模型管理页用它解析模型磁盘路径与同名 png 缩略图;
# 通常包含 ComfyUI 共享 models/loras 与安装目录自带的 models/loras。
COMFYUI_LORAS_DIRS=
# task_type -> workflow_id 路由表(相对子项目根目录或绝对路径)
TASK_ROUTING_FILE=workflows/task_routing.json
# 兼容层单任务同步等待上限(秒), 对端应用总超时 10 分钟
COMPAT_JOB_TIMEOUT=540
# 显存回收接口 POST /api/v1/vram/release
OLLAMA_CLIENT_HOST=127.0.0.1
OLLAMA_CLIENT_PORT=11434
# 触发回收后等待驱动归还显存的秒数
VRAM_SETTLE_SECONDS=6
